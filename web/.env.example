# Copy to web/.env.local on your machine. That file is gitignored.
# Names only. Do not put a real server address, phone number, code, or key here.

# Browser request prefix. Leave empty so the page and the API stay on the same origin.
# A full URL to another site will not work: the session cookie is SameSite=Strict,
# and the server does not enable credentialed CORS.
VITE_API_BASE=

# Used only by the Vite dev server to proxy /api and /ws. Not bundled into the site.
# Leave empty to use the local listen address documented for pantry-server.
PANTRY_DEV_PROXY=
