# Names and placeholders only. Copy to server.env on the machine that runs pantry-server.
# server.env is gitignored. Do not put real addresses, passwords, phone numbers, or test codes here.

PANTRY_PROFILE=prod
PANTRY_TEST_CLOCK=
PANTRY_TEST_TOKEN=

PANTRY_DB_URL=jdbc:postgresql://127.0.0.1:5432/pantry
PANTRY_DB_USER=pantry
PANTRY_DB_PASSWORD=

PANTRY_PHONE_ENC_KEY=
PANTRY_PHONE_HMAC_KEY=

# disabled until AUTH_MODE=test and both values below are set in server.env
AUTH_MODE=disabled
AUTH_TEST_CODE=
AUTH_TEST_PHONES=

PANTRY_FAMILY_PHOTO_MB=1024
PANTRY_MIN_FREE_MB=1500

PANTRY_LISTEN_HOST=127.0.0.1
PANTRY_LISTEN_PORT=18280
PANTRY_COOKIE_SECURE=true
